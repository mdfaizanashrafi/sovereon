# Database (PostgreSQL for both dev and production)
DATABASE_URL=postgresql://username:password@localhost:5432/sovereon

# Admin Session Secret (Required for admin panel)
SESSION_SECRET=your-super-secret-session-key-change-this

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Email Configuration (Resend API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Sovereon <partners@sovereon.online>
ADMIN_EMAIL=partners@sovereon.online

# Logging
LOG_LEVEL=debug

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
# Option 1: Use Redis connection URL (recommended for production)
# Get from Upstash, Redis Cloud, or your Redis provider
# REDIS_URL=redis://username:password@host:port

# Option 2: Use individual config (for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache settings
CACHE_ENABLED=true

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin rate limiting (stricter)
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX_REQUESTS=10
