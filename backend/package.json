{
  "name": "sovereon-backend",
  "version": "1.0.0",
  "description": "Sovereon Inc. Backend API",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "start:with-migrate": "npx prisma migrate deploy && npx prisma generate && node dist/app.js",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "ts-node src/database/seed.ts",
    "seed:cms": "ts-node src/database/seed-cms.ts",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "benchmark": "ts-node src/performance/benchmarks.ts",
    "benchmark:run": "ts-node -e \"require('./src/performance/benchmarks').runCriticalEndpointBenchmarks().then(r => console.log(JSON.stringify(r, null, 2)))\"",
    "metrics:init": "ts-node -e \"require('./src/performance/metrics').initializePerformanceMetrics()\""
  },
  "keywords": [],
  "author": "Sovereon Inc.",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "@sovereon/shared": "file:../shared",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.18.2",
    "@types/ioredis": "^4.28.10",
    "bcryptjs": "^2.4.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.0",
    "react-dom": "^18.3.1",
    "resend": "^3.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "zod": "^3.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "prisma": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
