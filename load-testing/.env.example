# ============================================================================
# LOAD TESTING ENVIRONMENT VARIABLES
# ============================================================================

# Base URL for the API (optional, defaults based on ENV)
BASE_URL=https://api-staging.sovereon.online

# Environment (local, development, staging, production)
ENV=staging

# Admin credentials for authenticated tests
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Optional: Custom headers for requests
# CUSTOM_HEADER_NAME=X-Custom-Header
# CUSTOM_HEADER_VALUE=custom-value

# Optional: InfluxDB output for metrics
# K6_OUT=influxdb=http://localhost:8086/k6

# Optional: Cloud output (Grafana Cloud k6)
# K6_CLOUD_TOKEN=your_cloud_token
# K6_CLOUD_PROJECT_ID=your_project_id
